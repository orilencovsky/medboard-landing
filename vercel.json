{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/he",
      "destination": "/?lang=he",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "mx_lang", "value": "en" }],
      "missing": [{ "type": "query", "key": "lang" }],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [
        { "type": "cookie", "key": "mx_lang" },
        { "type": "query", "key": "lang" },
        {
          "type": "header",
          "key": "accept-language",
          "value": "^[Hh][Ee]([-;,].*)?$"
        },
        { "type": "header", "key": "x-vercel-ip-country", "value": "IL" },
        {
          "type": "header",
          "key": "user-agent",
          "value": "^.*([Bb][Oo][Tt]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Cc][Rr][Aa][Ww][Ll]|Google-InspectionTool|GoogleOther|Mediapartners-Google|facebookexternalhit|WhatsApp).*$"
        }
      ],
      "destination": "/en",
      "permanent": false
    }
  ]
}
